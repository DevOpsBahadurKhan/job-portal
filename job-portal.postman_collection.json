{
  "info": {
    "_postman_id": "7d4e3d2d-ef26-4e0b-bbb7-6b68a2e31c7f",
    "name": "Job Portal API 2",
    "description": "Collection synchronized with the Express routes. Run the appropriate login request to populate its token variable. Register creates a CANDIDATE; promote a recruiter with an admin token before testing recruiter-only endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "candidateToken", "value": "" },
    { "key": "recruiterToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "companyId", "value": "1" },
    { "key": "jobId", "value": "1" },
    { "key": "userId", "value": "1" },
    { "key": "candidateName", "value": "Test Candidate" },
    { "key": "candidateEmail", "value": "candidate@example.com" },
    { "key": "candidatePassword", "value": "password123" },
    { "key": "recruiterEmail", "value": "recruiter@example.com" },
    { "key": "recruiterPassword", "value": "password123" },
    { "key": "adminEmail", "value": "admin@example.com" },
    { "key": "adminPassword", "value": "admin_password" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        { "name": "Register Candidate", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "options": { "raw": { "language": "json" } }, "raw": "{\n  \"name\": \"{{candidateName}}\",\n  \"email\": \"{{candidateEmail}}\",\n  \"password\": \"{{candidatePassword}}\"\n}" }, "url": "{{baseUrl}}/api/auth/register" } },
        { "name": "Login Candidate", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const body = pm.response.json();", "pm.test('Login succeeded', () => pm.expect(pm.response.code).to.equal(201));", "if (body.data?.token) pm.collectionVariables.set('candidateToken', body.data.token);"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "options": { "raw": { "language": "json" } }, "raw": "{\n  \"email\": \"{{candidateEmail}}\",\n  \"password\": \"{{candidatePassword}}\"\n}" }, "url": "{{baseUrl}}/api/auth/login" } },
        { "name": "Login Recruiter", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const body = pm.response.json();", "pm.test('Login succeeded', () => pm.expect(pm.response.code).to.equal(201));", "if (body.data?.token) pm.collectionVariables.set('recruiterToken', body.data.token);"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "options": { "raw": { "language": "json" } }, "raw": "{\n  \"email\": \"{{recruiterEmail}}\",\n  \"password\": \"{{recruiterPassword}}\"\n}" }, "url": "{{baseUrl}}/api/auth/login" } },
        { "name": "Login Admin", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const body = pm.response.json();", "pm.test('Login succeeded', () => pm.expect(pm.response.code).to.equal(201));", "if (body.data?.token) pm.collectionVariables.set('adminToken', body.data.token);"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "options": { "raw": { "language": "json" } }, "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}" }, "url": "{{baseUrl}}/api/auth/login" } },
        { "name": "Get Profile", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{candidateToken}}" }], "url": "{{baseUrl}}/api/auth/profile" } }
      ]
    },
    { "name": "Users", "item": [{ "name": "List Users", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/users" } }] },
    {
      "name": "Companies",
      "item": [
        { "name": "Create Company", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const body = pm.response.json();", "pm.test('Company created', () => pm.expect(pm.response.code).to.equal(201));", "if (body.data?.id) pm.collectionVariables.set('companyId', body.data.id);"] } }], "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{recruiterToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "options": { "raw": { "language": "json" } }, "raw": "{\n  \"name\": \"Acme Technologies\",\n  \"description\": \"Technology solutions company\",\n  \"website\": \"https://example.com\",\n  \"location\": \"Bengaluru\"\n}" }, "url": "{{baseUrl}}/companies" } },
        { "name": "Get My Company", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{recruiterToken}}" }], "url": "{{baseUrl}}/api/companies/me" } },
        { "name": "Get Company by ID", "request": { "method": "GET", "url": "{{baseUrl}}/api/companies/{{companyId}}" } },
        { "name": "Update Company", "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{recruiterToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "options": { "raw": { "language": "json" } }, "raw": "{\n  \"name\": \"Acme Technologies Ltd.\",\n  \"location\": \"Bengaluru, Karnataka\"\n}" }, "url": "{{baseUrl}}/companies/{{companyId}}" } }
      ]
    },
    {
      "name": "Jobs",
      "item": [
        { "name": "List Open Jobs", "request": { "method": "GET", "url": "{{baseUrl}}/api/jobs?page=1&limit=10&search=Developer&location=Remote&jobType=FULL_TIME&salaryMin=60000" } },
        { "name": "Get Job by ID", "request": { "method": "GET", "url": "{{baseUrl}}/api/jobs/{{jobId}}" } },
        { "name": "Create Job", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const body = pm.response.json();", "pm.test('Job created', () => pm.expect(pm.response.code).to.equal(201));", "if (body.data?.id) pm.collectionVariables.set('jobId', body.data.id);"] } }], "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{recruiterToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "options": { "raw": { "language": "json" } }, "raw": "{\n  \"title\": \"Backend Developer\",\n  \"description\": \"Build and maintain Node.js APIs.\",\n  \"location\": \"Remote\",\n  \"salaryMin\": 60000,\n  \"salaryMax\": 90000,\n  \"jobType\": \"FULL_TIME\",\n  \"status\": \"OPEN\",\n  \"skills\": \"Node.js, Express, MySQL\",\n  \"companyId\": {{companyId}}\n}" }, "url": "{{baseUrl}}/jobs" } },
        { "name": "Update Job", "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{recruiterToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "options": { "raw": { "language": "json" } }, "raw": "{\n  \"title\": \"Senior Backend Developer\",\n  \"salaryMax\": 110000\n}" }, "url": "{{baseUrl}}/jobs/{{jobId}}" } },
        { "name": "Delete Job", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{recruiterToken}}" }], "url": "{{baseUrl}}/api/jobs/{{jobId}}" } }
      ]
    },
    {
      "name": "Applications",
      "item": [
        { 
          "name": "Apply for Job", 
        "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{candidateToken}}" }, { "key": "Content-Type", "value": "application/json" }], 
        "body": { "mode": "raw", "options": { "raw": { "language": "json" } }, "raw": "{\n  \"coverLetter\": \"I am interested in this role and have relevant backend experience.\",\n  \"resumeUrl\": \"https://example.com/resume.pdf\"\n}" }, "url": "{{baseUrl}}/api/jobs/{{jobId}}/apply" } },
        { "name": "Get My Applications", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{candidateToken}}" }], "url": "{{baseUrl}}/api/my" } }
      ]
    },
    { "name": "Admin", "item": [{ "name": "Update User Role", "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "options": { "raw": { "language": "json" } }, "raw": "{\n  \"role\": \"RECRUITER\"\n}" }, "url": "{{baseUrl}}/api/admin/users/{{userId}}/role" } }] }
  ]
}
